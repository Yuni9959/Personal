{
  "name": "personal-tap-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bank": "node apps/mensa/tools/build-expanded-bank.mjs && npm run sync:bank",
    "build:bank:check": "node apps/mensa/tools/build-expanded-bank.mjs --check",
    "enrich:content": "node apps/mensa/tools/enrich-content-v2.mjs",
    "generate:answer-key": "node apps/mensa/tools/generate-answer-key.mjs",
    "sync:bank": "node apps/mensa/tools/sync-bank.mjs",
    "sync:volatility-reference": "node apps/volatility/tools/build-weekly-reference.mjs",
    "sync:volatility-data": "node apps/volatility/tools/sync-local-nasdaq.mjs && npm run sync:volatility-reference",
    "publish:volatility-data": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File apps/volatility/tools/refresh-and-deploy.ps1",
    "publish:university-release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/publish-university-release.ps1",
    "test:admission-sync": "node --test tools/tests/*.test.mjs",
    "test:volatility": "node --test apps/volatility/tests/*.test.mjs",
    "test:browser": "node apps/mensa/tests/browser-smoke.mjs",
    "validate:bank": "node apps/mensa/tests/validate-bank.mjs --profile=content-complete",
    "test": "node --test apps/mensa/tests/*.test.mjs && npm run test:volatility && npm run test:admission-sync && npm run build:bank:check && node apps/mensa/tests/validate-bank.mjs --profile=content-complete && node apps/mensa/tools/generate-answer-key.mjs --check",
    "test:release": "npm run test && npm run test:browser"
  }
}
